# Copy to .env and fill in your values
FALKORDB_HOST=localhost
FALKORDB_PORT=6379

# LLM settings — leave LLM_MODE=mock for fully reproducible demo
LLM_MODE=mock           # mock | openai | anthropic
OPENAI_API_KEY=         # only needed if LLM_MODE=openai
ANTHROPIC_API_KEY=      # only needed if LLM_MODE=anthropic

# Default tenant
DEFAULT_TENANT=demo
